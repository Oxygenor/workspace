# Обліковий запис Qplaze/Kanboard, під яким логіниться цей воркер. Лише
# власний легітимний акаунт. Ніколи не комітити реальні значення — виставляти
# їх у дашборді хостингу (Railway: вкладка Variables) або в локальному
# .env (який у .gitignore і ніколи не потрапляє в git).
QPLAZE_LOGIN=
QPLAZE_PASSWORD=

# Конкретна дошка Kanboard для зчитування, напр. https://kanboard.example.com/boards/2
QPLAZE_BOARD_URL=

# Supabase-проєкт цього застосунку. Service-role ключ обходить RLS — цей
# воркер є довіреним бекендом, той самий рівень довіри, що й Supabase Edge
# Functions у supabase/functions/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Workspace (у цьому застосунку), чия дошка має отримувати синхронізовані картки.
WORKSPACE_ID=

# Спільний секрет, який edge-функція qplaze-sync-trigger має передавати як
# `Authorization: Bearer <це значення>` для виклику POST /sync. Згенерувати
# можна, напр., через `openssl rand -hex 32`. Має точно збігатися із секретом
# QPLAZE_SYNC_API_KEY тієї edge-функції.
SYNC_API_KEY=

# Необов'язково — Railway/Render/Fly.io виставляють це автоматично; потрібно
# лише для локальної розробки.
PORT=8080
